     ",", "\"\<Gabriela Mistral\>\"", 
    ",", "\"\<J\[UAcute]lia Lopes de Almeida\>\"", 
    ",", "\"\<Machado de Assis\>\"", ",", "\"\<Lima Barreto (escritor)\>\"", 
    ",", "\"\<M\[AAcute]rio de Andrade\>\"", 
