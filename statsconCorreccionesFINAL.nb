Cell["\<\
Creamos la funci\[OAcute]n Wikirevisions, que da una serie de propiedades de \
la historia de ediciones de un art\[IAcute]culo. Por ejemplo, ofrece el ID de \
la revisi\[OAcute]n, el momento, el usuario, el tama\[NTilde]o final del art\
\[IAcute]culo despu\[EAcute]s de las revisiones, los comentarios hechos sobre \
la revisi\[OAcute]n. Pedimos, entre esas, el ID del revisor (incluye cuentas \
no registradas), el nombre de usuario, el momento, el comentario y el tama\
\[NTilde]o.
Del tama\[NTilde]o final, restamos el tama\[NTilde]o inicial, antes de la \
revisi\[OAcute]n, para ver si se trat\[OAcute] de una adici\[OAcute]n o una \
sustracci\[OAcute]n de texto. 
C\[OAcute]mo hago para ver si hay pocos usuarios que eliminan mucho en \
hombres y mujeres? Ser\[AAcute] que son muchos o pocos los eliminadores? Ser\
\[AAcute] que hay algunos usuarios comunes que son los grandes eliminadores?\
\>", "Text",ExpressionUUID->"35943696-c0d1-a64f-9211-980f41e78d76"],

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{
  "WikiRevisions", ",", "WikiTotalEditors", ",", "WikiTotalEditorsNumber", ",",
    "WikiTotalRevisionsNumber"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"WikiRevisions", "[", 
    RowBox[{"art_String", ",", "lang_String"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "data", ",", "cont", ",", "stop", ",", "revisions", ",", "sizes", ",", 
       "prevsizes", ",", "diff"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"cont", "=", "\"\<\>\""}], ";", "\[IndentingNewLine]", 
      RowBox[{"revisions", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Label", "[", "\"\<loop\>\"", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"data", "=", 
       RowBox[{"URLExecute", "[", 
        RowBox[{
         RowBox[{"WikiAPI", "[", "lang", "]"}], ",", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\"\<action\>\"", "->", "\"\<query\>\""}], ",", 
             RowBox[{"\"\<format\>\"", "->", "\"\<json\>\""}], ",", 
             RowBox[{"\"\<formatversion\>\"", "->", "2"}], ",", 
             RowBox[{"\"\<titles\>\"", "->", "art"}], ",", 
             RowBox[{"\"\<prop\>\"", "->", "\"\<revisions\>\""}], ",", 
             
             RowBox[{"\"\<rvprop\>\"", 
              "->", "\"\<ids|timestamp|user|userid|size|flags|comment|tags\>\"\
"}], ",", 
             RowBox[{"\"\<rvlimit\>\"", "->", "\"\<max\>\""}]}], "}"}], ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"cont", "==", "\"\<\>\""}], ",", 
             RowBox[{"{", "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"\"\<rvcontinue\>\"", "\[Rule]", "cont"}], "}"}]}], 
            "]"}]}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Print", "[", "data", "]"}], ";"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"revisions", "=", 
       RowBox[{"Join", "[", 
        RowBox[{"revisions", ",", 
         RowBox[{
          RowBox[{"ExtractKeyFromList", "[", 
           RowBox[{
            RowBox[{"\"\<revisions\>\"", "/.", 
             RowBox[{"(", 
              RowBox[{"\"\<pages\>\"", "/.", 
               RowBox[{"(", 
                RowBox[{"\"\<query\>\"", "/.", "data"}], ")"}]}], ")"}]}], ",", 
            RowBox[{"{", 
             
             RowBox[{"\"\<revid\>\"", ",", "\"\<user\>\"", 
              ",", "\"\<userid\>\"", ",", "\"\<timestamp\>\"", 
              ",", "\"\<comment\>\"", ",", "\"\<size\>\""}], "}"}]}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"stop", "=", 
       RowBox[{"TrueQ", "[", 
        RowBox[{"(", 
         RowBox[{"\"\<batchcomplete\>\"", "/.", "data"}], ")"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"Not", "[", "stop", "]"}], ",", 
        RowBox[{
         RowBox[{"cont", "=", 
          RowBox[{"\"\<rvcontinue\>\"", "/.", 
           RowBox[{"(", 
            RowBox[{"\"\<continue\>\"", "/.", "data"}], ")"}]}]}], ";", 
         RowBox[{"Goto", "[", "\"\<loop\>\"", "]"}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"sizes", "=", 
       RowBox[{"revisions", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", 
          RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"prevsizes", "=", 
       RowBox[{"Append", "[", 
        RowBox[{
         RowBox[{"Drop", "[", 
          RowBox[{"sizes", ",", "1"}], "]"}], ",", "0"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"diff", "=", 
       RowBox[{"sizes", "-", "prevsizes"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Append", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", "revisions", "]"}], ",", "diff"}], "]"}], 
       "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"WikiTotalEditors", "[", 
    RowBox[{"art_String", ",", "lang_String"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"revs", ",", "eds"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"revs", "=", 
       RowBox[{"WikiRevisions", "[", 
        RowBox[{"art", ",", "lang"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"eds", "=", 
       RowBox[{"revs", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Union", "[", "eds", "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"WikiTotalEditorsNumber", "[", 
    RowBox[{"art_String", ",", "lang_String"}], "]"}], ":=", 
   RowBox[{"Length", "[", 
    RowBox[{"WikiTotalEditors", "[", 
     RowBox[{"art", ",", "lang"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"WikiTotalEditorsNumber", "[", 
    RowBox[{"arts_List", ",", "lang_String"}], "]"}], ":=", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"WikiTotalEditorsNumber", "[", 
       RowBox[{"#", ",", "lang"}], "]"}], "&"}], ",", "arts"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"WikiTotalRevisionsNumber", "[", 
    RowBox[{"art_String", ",", "lang_String"}], "]"}], ":=", 
   RowBox[{"Length", "[", 
    RowBox[{"WikiRevisions", "[", 
     RowBox[{"art", ",", "lang"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"WikiTotalRevisionsNumber", "[", 
   RowBox[{"arts_List", ",", "lang_String"}], "]"}], ":=", 
  RowBox[{"Map", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"WikiTotalRevisionsNumber", "[", 
      RowBox[{"#", ",", "lang"}], "]"}], "&"}], ",", "arts"}], 
   "]"}]}]}], "Input",
 CellLabel->"In[48]:=",ExpressionUUID->"a8b7e0ad-be95-8742-9dcc-2a7cc2583bbd"],

