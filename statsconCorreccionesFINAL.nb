  3.9631554011509933`*^9}},ExpressionUUID->"dffb6592-a08c-b44e-bf7d-\
b6cad87fbf06"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "WikiAPI", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"WikiAPI", "[", "\"\<Portuguese\>\"", "]"}], 
   "=", "\"\<https://pt.wikipedia.org/w/api.php\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"WikiAPI", "[", "\"\<Spanish\>\"", "]"}], 
   "=", "\"\<https://es.wikipedia.org/w/api.php\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"WikiAPI", "[", "\"\<English\>\"", "]"}], 
   "=", "\"\<https://en.wikipedia.org/w/api.php\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"WikiAPI", "[", "\"\<French\>\"", "]"}], 
   "=", "\"\<https://fr.wikipedia.org/w/api.php\>\""}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.963155369447439*^9, 3.963155378696335*^9}, 
   3.964075909799137*^9},
 CellLabel->"In[2]:=",ExpressionUUID->"c448cb9a-9848-e443-bf82-4630e47362fe"],

Cell["\<\
Let\[CloseCurlyQuote]s look for some statistics of these authors and make \
charts with them to have a sense of their visibility/invisibility. \
\>", "Text",ExpressionUUID->"710d1f75-7239-9d4a-af5b-05ccbb80c5dd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "WikiName", ",", "WikiPageID", ",", "DigitStringQ", ",", "WikiPageQ", ",", 
    "WikiLanguages"}], "]"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "WikiName", " ", "returns", " ", "the", " ", "canonic", " ", "name", " ", 
    "of", " ", "an", " ", "article", " ", "in", " ", "a", " ", "given", " ", 
    "language"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"WikiName", "[", 
    RowBox[{"art_String", ",", "lang_String"}], "]"}], ":=", 
   RowBox[{"WikipediaData", "[", 
    RowBox[{"art", ",", "\"\<Title\>\"", ",", 
     RowBox[{"Language", "->", "lang"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"WikiName", "[", 
     RowBox[{"arts_List", ",", "lang_String"}], "]"}], ":=", 
    RowBox[{"Join", "@@", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"WikipediaData", "[", 
         RowBox[{"#", ",", "\"\<Title\>\"", ",", 
          RowBox[{"Language", "->", "lang"}]}], "]"}], "&"}], ",", 
       RowBox[{"Partition", "[", 
        RowBox[{"arts", ",", 
         RowBox[{"UpTo", "[", "50", "]"}]}], "]"}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "WikiPageID", " ", "returns", " ", "the", " ", "page", " ", "ID", " ", 
    "of", " ", "an", " ", "article", " ", "in", " ", "a", " ", "given", " ", 
    "language"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"WikiPageID", "[", 
    RowBox[{"art_String", ",", "lang_String"}], "]"}], ":=", 
   RowBox[{"WikipediaData", "[", 
    RowBox[{"art", ",", "\"\<PageID\>\"", ",", 
     RowBox[{"Language", "->", "lang"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"WikiPageID", "[", 
     RowBox[{"arts_List", ",", "lang_String"}], "]"}], ":=", 
    RowBox[{"Join", "@@", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"WikipediaData", "[", 
         RowBox[{"#", ",", "\"\<PageID\>\"", ",", 
          RowBox[{"Language", "->", "lang"}]}], "]"}], "&"}], ",", 
       RowBox[{"Partition", "[", 
        RowBox[{"arts", ",", 
         RowBox[{"UpTo", "[", "50", "]"}]}], "]"}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "DigitStringQ", " ", "returns", " ", "True", " ", "or", " ", "False"}], ",",
     " ", 
    RowBox[{
     RowBox[{
      RowBox[{
      "depending", " ", "of", " ", "whether", " ", "a", " ", "string", " ", 
       "is", " ", "solely", " ", "composed", " ", "of", " ", "digits", " ", 
       "0"}], "..."}], "9"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"DigitStringQ", "[", "str_", "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"StringQ", "[", "str", "]"}], ",", 
      RowBox[{"StringMatchQ", "[", 
       RowBox[{"str", ",", 
        RowBox[{"DigitCharacter", ".."}]}], "]"}], ",", "False"}], "]"}]}], 
   ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "WikiPageQ", " ", "returns", " ", "True", " ", "or", " ", "False"}], ",", 
    " ", 
    RowBox[{
    "depending", " ", "of", " ", "whether", " ", "a", " ", "specific", " ", 
     "article", " ", "exists", " ", "in", " ", "a", " ", "given", " ", 
     "language"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"WikiPageQ", "[", 
     RowBox[{"art_String", ",", "lang_String"}], "]"}], ":=", 
    RowBox[{"DigitStringQ", "[", 
     RowBox[{"WikipediaData", "[", 
      RowBox[{"art", ",", "\"\<PageID\>\"", ",", 
       RowBox[{"Language", "->", "lang"}]}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "WikiLanguages", " ", "returns", " ", "a", " ", "list", " ", "of", " ", 
    "languages", " ", "for", " ", "a", " ", "specific", " ", "article"}], " ",
    "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"WikiLanguages", "[", 
    RowBox[{"art_String", ",", "lang_String"}], "]"}], ":=", 
   RowBox[{"WikipediaData", "[", 
    RowBox[{"art", ",", "\"\<LanguagesList\>\"", ",", 
     RowBox[{"Language", "->", "lang"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"WikiLanguages", "[", 
    RowBox[{"arts_List", ",", "lang_String"}], "]"}], ":=", 
   RowBox[{"Join", "@@", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"WikipediaData", "[", 
        RowBox[{"#", ",", "\"\<LanguagesList\>\"", ",", 
         RowBox[{"Language", "->", "lang"}]}], "]"}], "&"}], ",", 
      RowBox[{"Partition", "[", 
       RowBox[{"arts", ",", 
        RowBox[{"UpTo", "[", "50", "]"}]}], "]"}]}], "]"}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9631479857756824`*^9, 3.963148145735449*^9}, {
   3.9631482427708225`*^9, 3.9631482572791615`*^9}, {3.9631483556125393`*^9, 
   3.9631484662283*^9}, {3.9631485683136425`*^9, 3.963148570256916*^9}, {
   3.963148915766308*^9, 3.963149060530485*^9}, {3.963149140872473*^9, 
   3.963149157089628*^9}, {3.963149266094387*^9, 3.96314931055101*^9}, {
   3.9631493568371735`*^9, 3.963149481892393*^9}, {3.9631498614178066`*^9, 
   3.963149878176161*^9}, {3.963164651584406*^9, 3.9631647123588295`*^9}, {
   3.9634084563854713`*^9, 3.963408464348057*^9}, 3.963472483474354*^9, {
   3.9639079339592247`*^9, 3.963907951473694*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"d86807b9-2ac1-e145-95d1-8c860175b969"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "WikiLanguageChart", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"WikiLanguageChart", "[", 
   RowBox[{"arts_List", ",", "lang_String"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"data", ",", "counts"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"data", "=", 
      RowBox[{"WikiLanguages", "[", 
       RowBox[{"arts", ",", "lang"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"counts", "=", 
      RowBox[{"Map", "[", 
       RowBox[{"Length", ",", "data"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"BarChart", "[", 
      RowBox[{"counts", ",", 
       RowBox[{"ChartLegends", "->", "arts"}], ",", 
       RowBox[{"ChartStyle", "->", "\"\<Pastel\>\""}], ",", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Writer's Wikipedia article\>\"", 
          ",", "\"\<number of languages\>\""}], "}"}]}], ",", 
       RowBox[{"ImageSize", "->", "Large"}], ",", 
       RowBox[{"LabelingFunction", "->", "Above"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"ae1a05d4-a193-bf48-ab7a-d1526a006d8f"],

