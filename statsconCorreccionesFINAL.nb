Cell["\<\
API based function that returns the list of categories to which a given entry \
in a given language belongs:\
\>", "Text",
 CellChangeTimes->{{3.9631553800819073`*^9, 3.9631554601361027`*^9}, {
  3.9631639163594494`*^9, 3.963163952528427*^9}, {3.9631655350499077`*^9, 
  3.9631655875356007`*^9}},ExpressionUUID->"bcf2e187-28bb-3045-a558-\
eec907a88893"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "WikiCategories", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"WikiCategories", "[", 
   RowBox[{"art_String", ",", "lang_String"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"data", ",", "cont", ",", "stop", ",", "categs"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"cont", "=", "\"\<\>\""}], ";", "\[IndentingNewLine]", 
     RowBox[{"categs", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Label", "[", "\"\<loop\>\"", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"data", "=", 
      RowBox[{"URLExecute", "[", 
       RowBox[{
        RowBox[{"WikiAPI", "[", "lang", "]"}], ",", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\"\<action\>\"", "->", "\"\<query\>\""}], ",", 
            RowBox[{"\"\<format\>\"", "->", "\"\<json\>\""}], ",", 
            RowBox[{"\"\<formatversion\>\"", "->", "2"}], ",", 
            RowBox[{"\"\<titles\>\"", "->", "art"}], ",", 
            RowBox[{"\"\<prop\>\"", "->", "\"\<categories\>\""}], ",", 
            RowBox[{"\"\<cllimit\>\"", "->", "\"\<max\>\""}]}], "}"}], ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"cont", "==", "\"\<\>\""}], ",", 
            RowBox[{"{", "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"\"\<clcontinue\>\"", "\[Rule]", "cont"}], "}"}]}], 
           "]"}]}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"categs", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"categs", ",", 
        RowBox[{
         RowBox[{"ExtractKeyFromList", "[", 
          RowBox[{
           RowBox[{"\"\<categories\>\"", "/.", 
            RowBox[{"(", 
             RowBox[{"\"\<pages\>\"", "/.", 
              RowBox[{"(", 
               RowBox[{"\"\<query\>\"", "/.", "data"}], ")"}]}], ")"}]}], 
           ",", "\"\<title\>\""}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"stop", "=", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"(", 
        RowBox[{"\"\<batchcomplete\>\"", "/.", "data"}], ")"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"Not", "[", "stop", "]"}], ",", 
       RowBox[{
        RowBox[{"cont", "=", 
         RowBox[{"\"\<clcontinue\>\"", "/.", 
          RowBox[{"(", 
           RowBox[{"\"\<continue\>\"", "/.", "data"}], ")"}]}]}], ";", 
        RowBox[{"Goto", "[", "\"\<loop\>\"", "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", "categs"}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.9631648984199657`*^9, 3.96316493868009*^9}, {
  3.963164971486717*^9, 3.963165008752962*^9}, {3.963165089162653*^9, 
  3.9631650897029095`*^9}, {3.9631655916776485`*^9, 3.9631656242756386`*^9}, {
  3.9631656731586056`*^9, 3.9631657391808777`*^9}, {3.9631658282623863`*^9, 
  3.963165829960888*^9}, {3.9631658676149216`*^9, 3.9631658681249447`*^9}},
 CellLabel->"In[69]:=",ExpressionUUID->"631c3b05-2940-4a49-beac-59d4e9ca6fda"],

