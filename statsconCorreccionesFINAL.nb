Cell["\<\
The first think we notice is that the two most prominent in terms of global \
circulation are not lusophone but spanish-speaking. It is surprising that \
Clarice Lispector and Machado de Assis, the two most prominent in the \
lusohpone world, are way behind them. The two least circulating are black \
writers, Carolina Maria de Jesus and Lima Barretoin which we see \
intersectional meanings involving class, race and gender. \
\>", "Text",ExpressionUUID->"7bdb0b89-6dc2-a246-a028-469d38ee924d"],

Cell[CellGroupData[{

Cell["\<\
Now, we will make a chart with the sizes of the different pages in Portuguese\
\>", "Subsubsection",ExpressionUUID->"113299c1-8c7b-b444-9d62-e374e7231ed4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "WikiPageSize", "]"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "This", " ", "function", " ", "returns", " ", "the", " ", "lenght", " ", 
    "of", " ", "an", " ", "article", " ", "in", " ", "a", " ", "given", " ", 
    "language"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"WikiPageSize", "[", 
    RowBox[{"articles_List", ",", "lang_String"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"arts", ",", "data", ",", "titles", ",", "pagesize"}], "}"}], ",",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"arts", "=", 
        RowBox[{"StringRiffle", "[", 
         RowBox[{"articles", ",", "\"\<|\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"data", "=", 
        RowBox[{"URLExecute", "[", 
         RowBox[{
          RowBox[{"WikiAPI", "[", "lang", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\"\<action\>\"", "->", "\"\<query\>\""}], ",", 
            RowBox[{"\"\<format\>\"", "->", "\"\<json\>\""}], ",", 
            RowBox[{"\"\<formatversion\>\"", "->", "2"}], ",", 
            RowBox[{"\"\<titles\>\"", "->", "arts"}], ",", 
            RowBox[{"\"\<prop\>\"", "->", "\"\<info\>\""}]}], "}"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"titles", "=", 
        RowBox[{"\"\<title\>\"", "/.", 
         RowBox[{"(", 
          RowBox[{"\"\<pages\>\"", "/.", 
           RowBox[{"(", 
            RowBox[{"\"\<query\>\"", "/.", "data"}], ")"}]}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"pagesize", "=", 
        RowBox[{"Map", "[", 
         RowBox[{"ToExpression", ",", 
          RowBox[{"\"\<length\>\"", "/.", 
           RowBox[{"(", 
            RowBox[{"\"\<pages\>\"", "/.", 
             RowBox[{"(", 
              RowBox[{"\"\<query\>\"", "/.", "data"}], ")"}]}], ")"}]}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"Not", "[", 
          RowBox[{"SameQ", "[", 
           RowBox[{
            RowBox[{"Union", "[", "titles", "]"}], ",", 
            RowBox[{"Union", "[", "articles", "]"}]}], "]"}], "]"}], ",", 
         RowBox[{
         "Print", "[", "\"\<Warning (LG): Probable API spelling mismatch.\>\"",
           "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"articles", "/.", 
        RowBox[{"Inner", "[", 
         RowBox[{"Rule", ",", "titles", ",", "pagesize", ",", "List"}], 
         "]"}]}]}]}], "\[IndentingNewLine]", "]"}], "/;", 
    RowBox[{
     RowBox[{"Length", "[", "articles", "]"}], "<=", "40"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"WikiPageSize", "[", 
    RowBox[{"art_String", ",", "lang_String"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"WikiPageSize", "[", 
     RowBox[{
      RowBox[{"{", "art", "}"}], ",", "lang"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"WikiPageSize", "[", 
    RowBox[{"articles_List", ",", "lang_String"}], "]"}], ":=", 
   RowBox[{"Join", "@@", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"WikiPageSize", "[", 
        RowBox[{"#", ",", "lang"}], "]"}], "&"}], ",", 
      RowBox[{"Partition", "[", 
       RowBox[{"articles", ",", 
        RowBox[{"UpTo", "[", "40", "]"}]}], "]"}]}], "]"}]}]}], 
  ";"}]}], "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"42465b1b-9999-4046-b629-2555c661ba32"],

Cell["\<\
NOTE WikiPageSize is giving back the page sizes according to the pageid \
number (from lowest to highest) . We need to modify the code so that it \
coincides with the original list . \[LineSeparator]NOTE 2 I changed code. We \
need to be sure that \[OpenCurlyDoubleQuote]title\[CloseCurlyDoubleQuote] as \
returned by the API coincides with what we gave it in articles parameter\
\>", "Text",ExpressionUUID->"5c61e20c-bc67-fa47-953c-a5b50be9f3cb"],

